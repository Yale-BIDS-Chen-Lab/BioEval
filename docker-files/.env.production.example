# Production environment template for BioEval.
# Copy to `.env` and replace EVERY value below. Do NOT reuse the dev defaults
# from .env.example — they are public and unsafe for any internet-facing deploy.
#
# The backend refuses to start (NODE_ENV=production) if BETTER_AUTH_SECRET is
# missing, too short, or still the committed dev default.

# --- Postgres (use strong, unique credentials) ---
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24
POSTGRES_DB=bioeval
POSTGRES_HOST_PORT=5432

# --- RabbitMQ (do NOT ship guest/guest in production) ---
RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# --- MinIO (do NOT ship the sample creds) ---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- Auth secret: REQUIRED. Generate with: openssl rand -base64 32 ---
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# --- Public URLs (set to your real HTTPS origin) ---
NODE_ENV=production
FRONTEND_URL=https://your-domain.example
VITE_BACKEND_URL=https://your-domain.example
INFERENCE_SERVICE_URL=http://inference:8000
