# BioEval environment. Copy to `.env`:  cp .env.example .env
#
# This runs the production build (NODE_ENV=production). It boots as-is for a
# local trial, but BEFORE any shared or remote deployment you MUST replace the
# secrets below with strong, unique values:
#   openssl rand -base64 32   # BETTER_AUTH_SECRET
#   openssl rand -base64 24   # DB / RabbitMQ / MinIO passwords
# The backend refuses to start if BETTER_AUTH_SECRET is missing or too short.

NODE_ENV=production

# --- Postgres ---
POSTGRES_USER=bioeval
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=bioeval
POSTGRES_HOST_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=bioeval
RABBITMQ_PASSWORD=change-me-before-deploying
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# --- MinIO ---
MINIO_ROOT_USER=bioeval
MINIO_ROOT_PASSWORD=change-me-before-deploying
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- Auth secret (REQUIRED). Generate with: openssl rand -base64 32 ---
BETTER_AUTH_SECRET=change-me-run-openssl-rand-base64-32

# --- URLs: localhost for local access; set to your real origin for remote use ---
FRONTEND_URL=http://localhost:3000
VITE_BACKEND_URL=http://localhost:3001
INFERENCE_SERVICE_URL=http://inference:8000
