{
  // Production build config. rootDir=src so `src/index.ts` emits to
  // `dist/index.js` (what `start:dist` runs). scripts/ and drizzle.config.ts
  // are intentionally not compiled — they run via ts-node.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
